;; -*- lexical-binding: t; -*-
;; -------------------------------------------------------------------------------------------------
;; Configuration
;; -------------------------------------------------------------------------------------------------

;; Reopen files at the last visited position
(save-place-mode 1)

;; Keep minibuffer history across restarts; the default keeps only 100
(setq history-length 1000)
(savehist-mode 1)

;; Track recently visited files
(recentf-mode 1)
